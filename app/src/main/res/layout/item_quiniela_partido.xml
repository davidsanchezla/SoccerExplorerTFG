<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_news_card_surface"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivQuinielaHomeLogo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/matches_team_logo_desc"
            android:src="@mipmap/ic_launcher_round"
            tools:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/tvQuinielaVs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="VS"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivQuinielaAwayLogo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/matches_team_logo_desc"
            android:src="@mipmap/ic_launcher_round"
            tools:src="@mipmap/ic_launcher_round" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvQuinielaMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_news_chip"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="Sabado, 20:00" />

    <RadioGroup
        android:id="@+id/rgPronostico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbPickHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/primary"
            android:gravity="start|center_vertical"
            android:text="1"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rbPickDraw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/primary"
            android:gravity="center"
            android:text="X"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rbPickAway"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/primary"
            android:gravity="end|center_vertical"
            android:text="2"
            android:textColor="@color/text_primary" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvQuinielaResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Resultado: 2 - 1 (Acierto)"
        tools:visibility="visible" />

</LinearLayout>
