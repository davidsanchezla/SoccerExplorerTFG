<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarQuiniela"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_variant"
        android:elevation="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:navigationIcon="@android:drawable/ic_media_previous"
        app:navigationIconTint="@color/on_primary"
        app:title="@string/quiniela_title"
        app:titleTextColor="@color/on_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvQuinielaHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Liga PD · Semana 2026-W11" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivQuinielaRankBadge"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/profile_level_label"
                android:scaleType="fitCenter"
                android:src="@drawable/canterano"
                tools:src="@drawable/leyenda" />

            <TextView
                android:id="@+id/tvQuinielaRank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Rango: Canterano (1) · XP: 0" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvQuinielaStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_news_chip"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Aun no puedes editar: la jornada ya ha comenzado."
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/pbQuiniela"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQuiniela"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="8dp"
            tools:itemCount="5"
            tools:listitem="@layout/item_quiniela_partido" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarQuiniela"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/primary"
            android:enabled="false"
            android:text="@string/quiniela_save_button"
            android:textAllCaps="false"
            android:textColor="@color/on_primary" />

    </LinearLayout>

</LinearLayout>
